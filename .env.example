# Deployer private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Basescan API key for contract verification
BASESCAN_API_KEY=your_basescan_api_key_here

# Base Mainnet RPC (optional, defaults to public)
BASE_RPC_URL=https://mainnet.base.org

# Deployed contract addresses (filled in after deploy)
ARENA_COIN_ADDRESS=
ARENA_FIGHTER_NFT_ADDRESS=
ARENA_REWARD_VAULT_ADDRESS=
ARENA_BATTLE_ADDRESS=
ARENA_STAKING_ADDRESS=
ARENA_MARKETPLACE_ADDRESS=
ARENA_LEADERBOARD_ADDRESS=

# Deployer address (for verify.js)
DEPLOYER_ADDRESS=

# Database URL (provided by Replit)
DATABASE_URL=

# Port for backend server
PORT=3001

# Frontend contract addresses (Vite env vars)
VITE_ARENA_COIN_ADDRESS=
VITE_ARENA_FIGHTER_NFT_ADDRESS=
VITE_ARENA_REWARD_VAULT_ADDRESS=
VITE_ARENA_BATTLE_ADDRESS=
VITE_ARENA_STAKING_ADDRESS=
VITE_ARENA_MARKETPLACE_ADDRESS=
VITE_ARENA_LEADERBOARD_ADDRESS=

# Telegram Bot Token (for Telegram Mini App)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
